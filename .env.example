# McDonald's GMA access (see docs/CAPTURE.md). Never commit the real .env.
MCD_REFRESH_TOKEN=
MCD_CLIENT_ID=
# JSON object of the extra headers captured from the app, e.g. {"mcd-marketid":"CA","user-agent":"..."}
MCD_HEADERS_JSON={}
# Storage: local (default) or s3
MCDOCPP_STORAGE=local
MCDOCPP_OUT_DIR=./out
S3_ENDPOINT_URL=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
